rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /users/{uid}/demoPayments/{paymentId} {
   allow read: if request.auth != null && request.auth.uid == uid;
   allow create, update: if request.auth != null && request.auth.uid == uid
    && request.resource.data.keys().hasOnly(['amountInCents', 'status', 'simulation'])
    && request.resource.data.amountInCents is int
    && request.resource.data.amountInCents > 0 && request.resource.data.amountInCents <= 100000000
    && request.resource.data.status in ['approved', 'declined', 'unknown']
    && request.resource.data.simulation == true;
   allow delete: if false;
  }
 }
}
